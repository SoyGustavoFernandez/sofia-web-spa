{
  "name": "sofia-web-spa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint --fix",
    "precommit:lint": "lint-staged",
    "lint:fast": "eslint --cache --cache-location node_modules/.cache/eslint --fix",
    "lint:ci": "ESLINT_TYPEAWARE=true eslint --max-warnings=0 .",
    "prepare": "husky install"
  },
  "dependencies": {
    "@angular/animations": "~19.2.19",
    "@angular/cdk": "~19.2.19",
    "@angular/common": "~19.2.19",
    "@angular/compiler": "~19.2.19",
    "@angular/core": "~19.2.19",
    "@angular/forms": "~19.2.19",
    "@angular/material": "~19.2.19",
    "@angular/platform-browser": "~19.2.19",
    "@angular/platform-browser-dynamic": "~19.2.19",
    "@angular/router": "~19.2.19",
    "@jsverse/transloco": "^7.6.1",
    "angular-tabler-icons": "^3.26.0",
    "iconify": "^1.4.0",
    "ngx-scrollbar": "^18.0.0",
    "rxjs": "~7.8.2",
    "sass": "^1.97.3",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~19.2.22",
    "@angular-eslint/eslint-plugin": "^19.8.1",
    "@angular-eslint/eslint-plugin-template": "^19.8.1",
    "@angular/cli": "~19.2.22",
    "@angular/compiler-cli": "~19.2.19",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^22.0.0",
    "angular-eslint": "^19.8.1",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^8.0.3",
    "lint-staged": "^16.3.1",
    "prettier": "^3.8.3",
    "prettier-eslint": "^16.4.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.56.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --cache --cache-location node_modules/.cache/eslint --fix"
    ],
    "*.{html,css,scss,md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
